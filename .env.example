# 필수 — 기본값 없음. 미설정 시 docker compose up 이 즉시 실패한다
SEVI_DB_PASSWORD=change-me
# 필수 — 세션 쿠키 서명 키. 긴 임의 문자열로 반드시 바꾸세요
SEVI_SESSION_SECRET=change-me-to-a-long-random-string

# /dev/dri 접근용 호스트 GID — `getent group video` / `getent group render` 로 확인
SEVI_GID_VIDEO=44
SEVI_GID_RENDER=992

# ---- 앞단 리버스 프록시 ----
# TLS 와 외부 도메인은 앞단 Caddy 가 처리한다. sevi 는 127.0.0.1:8000 에서 HTTP 로 듣는다.
# Caddy 예시:
#   sevi.example.com {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:8000
#   }
