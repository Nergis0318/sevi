# 필수 — 기본값 없음. 미설정 시 docker compose up 이 즉시 실패한다
SEVI_DB_PASSWORD=change-me
# 필수 — 세션 쿠키 서명 키. 긴 임의 문자열로 반드시 바꾸세요
SEVI_SESSION_SECRET=change-me-to-a-long-random-string

# /dev/dri 접근용 호스트 GID — `getent group video` / `getent group render` 로 확인
SEVI_GID_VIDEO=44
SEVI_GID_RENDER=992

# ---- 공개 배포 (TLS) 전용 ----
# 로컬 개발: `docker compose up` (TLS 없음, 아래 값 불필요)
# 공개 배포: `docker compose -f compose.yml -f compose.deploy.yml up -d` — 아래 값 필수
# SEVI_DOMAIN=example.com
# SEVI_ACME_EMAIL=admin@example.com
# 선택 — ACME 저장소 경로 (기본 /letsencrypt/acme.json)
# SEVI_ACME_STORAGE=/letsencrypt/acme.json
